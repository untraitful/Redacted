{
  "manifest_version": 3,
  "name": "Redactor",
  "version": "0.0.0",
  "description": "Replaces secrets and personal data with placeholders before they reach AI chat sites. 100% local.",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://grok.com/*",
    "https://poe.com/*"
  ],
  "optional_host_permissions": [
    "https://x.com/*",
    "https://github.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "__HOSTS__"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Redactor",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "redact-input": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Redact the current input"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "redactor@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
